# ==============================================================
#  WeCare — modèle de configuration
#  Copier ce fichier en `.env` (jamais commité) puis l'adapter.
#  Ce fichier est lu à la fois par Symfony et par Docker Compose.
# ==============================================================

###> symfony/framework-bundle ###
APP_ENV=dev
# Générer une valeur unique : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=ChangeMeChangeMeChangeMeChangeMe
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost

###> doctrine/doctrine-bundle ###
# Hors Docker (symfony serve + MariaDB/MySQL local).
# Dans Docker, cette valeur est remplacée par celle de compose.yaml (hôte "database").
DATABASE_URL="mysql://wecare:wecare@127.0.0.1:3307/wecare?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

# --------------------------------------------------------------
#  Docker Compose
# --------------------------------------------------------------
# Mots de passe MariaDB (à changer impérativement en production)
DB_PASSWORD=wecare
DB_ROOT_PASSWORD=root

# Ports exposés sur l'hôte
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT=3307

# --------------------------------------------------------------
#  PRODUCTION (VPS) uniquement — décommenter et adapter
# --------------------------------------------------------------
# APP_ENV=prod
# COMPOSE_FILE=compose.yaml              # ignore compose.override.yaml (dev)
# SERVER_NAME=vps114753.serveur-vps.net  # Caddy obtient le certificat Let's Encrypt pour ce domaine
# DEFAULT_URI=https://vps114753.serveur-vps.net
# ACME_EMAIL=contact@exemple.fr
# HTTP_PORT=80
# HTTPS_PORT=443
