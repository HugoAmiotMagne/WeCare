parameters:
	ignoreErrors:
		-
			message: '#^Offset 0 on non\-empty\-list\<string\> on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Controller/Admin/DashboardController.php

		-
			message: '#^Using nullsafe method call on non\-nullable type App\\Entity\\Utilisateur\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Controller/Admin/DashboardController.php

		-
			message: '#^Using nullsafe property access "\?\-\>value" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Controller/Admin/DashboardController.php

		-
			message: '#^Using nullsafe property access "\?\-\>value" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Controller/Admin/NotificationsController.php

		-
			message: '#^Using nullsafe property access "\?\-\>value" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Controller/Admin/PatientsController.php

		-
			message: '#^Comparison operation "\<" between 0\|1\|2\|3\|4\|5\|6 and 7 is always true\.$#'
			identifier: smaller.alwaysTrue
			count: 1
			path: src/Controller/Admin/SoignantsController.php

		-
			message: '#^Comparison operation "\>\=" between 0\|1\|2\|3\|4\|5\|6 and 0 is always true\.$#'
			identifier: greaterOrEqual.alwaysTrue
			count: 1
			path: src/Controller/Admin/SoignantsController.php

		-
			message: '#^Result of && is always true\.$#'
			identifier: booleanAnd.alwaysTrue
			count: 1
			path: src/Controller/Admin/SoignantsController.php

		-
			message: '#^Call to an undefined method App\\Entity\\Beneficiaire\:\:getAidant\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Controller/Beneficiaire/MonCompteController.php

		-
			message: '#^Call to an undefined method App\\Entity\\Beneficiaire\:\:getAidant\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Controller/Intervenant/BeneficiaireController.php

		-
			message: '#^Property App\\Entity\\Abonnement\:\:\$id \(int\|null\) is never assigned int so it can be removed from the property type\.$#'
			identifier: property.unusedType
			count: 1
			path: src/Entity/Abonnement.php

		-
			message: '#^Property App\\Entity\\Administrateur\:\:\$id \(int\|null\) is never assigned int so it can be removed from the property type\.$#'
			identifier: property.unusedType
