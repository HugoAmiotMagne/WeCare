			identifier: property.unusedType
			count: 1
			path: src/Entity/Intervenant.php

		-
			message: '#^Property App\\Entity\\Intervenant\:\:\$statut \(string\|null\) is never assigned null so it can be removed from the property type\.$#'
			identifier: property.unusedType
			count: 1
			path: src/Entity/Intervenant.php

		-
