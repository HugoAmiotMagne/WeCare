{
	# Adresse de contact pour Let's Encrypt (ACME)
	email {$ACME_EMAIL:admin@wecare.fr}
}

# SERVER_NAME = nom de domaine en prod (HTTPS automatique via Let's Encrypt)
#             = http://localhost en dev (HTTP simple)
{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	php_fastcgi php:9000 {
		root /app/public
	}
	file_server
}
